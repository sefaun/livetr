{
  "name": "livetr",
  "version": "1.0.0",
  "author": "SEFA UN",
  "description": "This is Livetr Desktop App",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron": "node scripts/startElectron.js",
    "start": "npm run build && electron .",
    "setup": "npm run build && electron-builder"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tailwindcss/vite": "^4.0.13",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^35.0.1",
    "electron-builder": "^24.13.3",
    "element-plus": "^2.9.6",
    "sass": "^1.87.0",
    "tailwindcss": "^4.0.13",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.4"
  },
  "build": {
    "electronVersion": "35.0.1",
    "appId": "com.livetr.id",
    "productName": "Livetr",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "store/nodebar",
        "to": "store/nodebar",
        "filter": [
          "bigbuckbunny.mp4",
          "test-audio.mp3",
          "test-bg-image.jpg",
          "test-image.png"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon-260x260.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "public/icon-260x260.png",
      "target": [
        "dmg"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Livetr uses the camera as a live stream source.",
        "NSMicrophoneUsageDescription": "Livetr uses the microphone as a live stream audio source."
      }
    },
    "linux": {
      "icon": "public/icon-260x260.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "engines": {
    "node": ">= 20.11.0"
  }
}
